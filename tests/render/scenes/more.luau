-- Sections, boxes, color picker, code, long text.
local Window = Brine:CreateWindow({ Title = "Brine", Theme = THEME, Size = UDim2.fromOffset(700, 560), AutoScale = false })
run(0.1)
local T = Window:Tab({ Title = "Appearance", Icon = "palette", ShowTabTitle = true })
local S1 = T:Section({ Title = "Display", Desc = "How the window looks on your screen", Icon = "monitor", Opened = true })
S1:Colorpicker({ Title = "Personal color", Default = Color3.fromHex("B8D8CF") })
S1:Dropdown({ Title = "Theme", Values = { "Liquid", "Brine" }, Value = "Liquid", Callback = function() end })
local S2 = T:Section({ Title = "Boxed section", Box = true, BoxBorder = true, Opened = true })
S2:Toggle({ Title = "Transparent window", Desc = "A longer description that has to wrap on to a second line without touching the switch beside it", Value = false })
S2:Button({ Title = "Centered action", Justify = "Center", Icon = "sparkles" })
T:Code({ Title = "Example", Code = "local x = 1\nprint(x)" })
T:Select()
run(2)
emit()
