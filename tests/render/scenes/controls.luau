-- Every control kind on one page, with locked and colored states.
local Window = Brine:CreateWindow({ Title = "Brine", Author = "by Salty", Theme = THEME, Size = UDim2.fromOffset(850, 560), User = { Enabled = true, Anonymous = true }, MaxSize = Vector2.new(880, 1000), HideSearchBar = false, AutoScale = false })
run(0.1)
local T = Window:Tab({ Title = "Controls", Icon = "sliders-horizontal", ShowTabTitle = true })
Window:Divider()
Window:Tab({ Title = "A much longer tab title that wraps", Icon = "palette" })
Window:Tab({ Title = "Colored", Icon = "house", IconColor = Color3.fromHex("1A7F70"), IconShape = "Square" })
Window:CreateTopbarButton("Settings", "settings", function() end, 990)
Window:Tag({ Title = "v0.3.14", Color = Color3.fromHex("DCE0E8") })
T:Slider({ Title = "Sensitivity", Desc = "Fine steps", Step = 0.1, Value = { Min = 0, Max = 2, Default = 0.8 } })
T:Input({ Title = "Session name", Value = "Evening", Placeholder = "Name this session" })
T:Input({ Title = "Invite code", Placeholder = "Paste a code", InputIcon = "ticket" })
T:Keybind({ Title = "Shortcut", Value = "K" })
T:Toggle({ Title = "Confirm actions", Type = "Checkbox", Value = true })
T:ProgressBar({ Title = "Upload", Value = { Min = 0, Max = 100, Default = 42 } })
T:Toggle({ Title = "Voice", Desc = "Needs a microphone", Locked = true, LockedTitle = "Unavailable" })
T:Button({ Title = "Delete saved data", Desc = "Removes every profile", Color = Color3.fromHex("C0392B"), Icon = "trash-2" })
local H = T:HStack({})
H:Button({ Title = "Reset", Icon = "rotate-ccw" })
H:Button({ Title = "Save", Icon = "check" })
T:Select()
run(2)
emit()
